# ============================================================
# VendIA — Variables de entorno
# Copia este archivo como .env.local y complétalo.
# .env.local nunca se sube al repositorio.
# ============================================================

# --- Auth.js (obligatorio) ---
# Genera el secreto con:  npx auth secret
AUTH_SECRET=

# --- Base de datos: Neon Postgres ---
# neon.tech → nuevo proyecto → Connection string
# Mientras esté vacía, la app funciona en modo demostración.
#
# Rol propietario. Postgres exime al propietario de las políticas RLS, así
# que esta cadena las ignora. Se usa solo para el registro (donde todavía
# no hay sesión) y para las métricas agregadas del super-admin.
# Cuando la app toca datos de un vendedor baja de privilegios sola, con
# SET LOCAL ROLE app_user dentro de la transacción, y ahí sí se aplican
# las políticas. Por eso basta con esta única credencial.
DATABASE_URL=

# --- Almacenamiento: Vercel Blob (paso 2, fotos de productos) ---
BLOB_READ_WRITE_TOKEN=

# --- Claude / Anthropic (paso 4, redacta el copy publicitario) ---
# console.anthropic.com → Settings → API Keys
# NUNCA con prefijo NEXT_PUBLIC_: solo se lee desde el servidor.
ANTHROPIC_API_KEY=

# --- Fal.ai / FLUX (paso 4, genera el fondo de la pieza) ---
# fal.ai → Dashboard → Keys
FAL_KEY=
